{
  "name": "marche-herblay-v6",
  "version": "6.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.js",
    "dev": "npm run build && node --env-file-if-exists=.env scripts/dev.mjs",
    "test:e2e": "playwright test",
    "check:function": "esbuild netlify/functions/api.mjs --bundle --platform=node --target=node22 --format=esm --outfile=.netlify/check/api.mjs",
    "format": "prettier --write public lib netlify scripts test package.json playwright.config.js README.md"
  },
  "dependencies": {
    "@netlify/blobs": "^10.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10"
  }
}
